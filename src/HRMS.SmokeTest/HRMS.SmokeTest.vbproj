<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 1. Use the Windows-specific .NET 10 target -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HRMS.SmokeTest</RootNamespace>
    <AssemblyName>HRMS.SmokeTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Data" />
    <ProjectReference Include="..\HRMS.Common\HRMS.Common.vbproj" />
    <ProjectReference Include="..\HRMS.Models\HRMS.Models.vbproj" />
    <ProjectReference Include="..\HRMS.DAL\HRMS.DAL.vbproj" />
    <ProjectReference Include="..\HRMS.BLL\HRMS.BLL.vbproj" />
  </ItemGroup>
</Project>
